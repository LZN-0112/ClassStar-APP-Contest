generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model activities {
  id                     String                   @id @db.Char(36)
  class_id               String                   @db.Char(36)
  publisher_id           String                   @db.Char(36)
  title                  String                   @db.VarChar(200)
  event_date             DateTime                 @db.Date
  event_time             DateTime?                @db.Time(0)
  location               String?                  @db.VarChar(255)
  capacity               Int?
  cover_url              String?                  @db.VarChar(500)
  deadline               DateTime?
  status                 String                   @default("registering") @db.VarChar(20)
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @default(now())
  classes                classes                  @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_act_class")
  users                  users                    @relation(fields: [publisher_id], references: [id], onUpdate: NoAction, map: "fk_act_publisher")
  activity_registrations activity_registrations[]

  @@index([class_id, status], map: "idx_class_status")
  @@index([publisher_id], map: "idx_publisher")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model activity_registrations {
  id            String     @id @db.Char(36)
  activity_id   String     @db.Char(36)
  student_id    String     @db.Char(36)
  status        String     @default("pending") @db.VarChar(20)
  registered_at DateTime   @default(now())
  updated_at    DateTime   @default(now())
  activities    activities @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ar_act")
  users         users      @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ar_student2")

  @@unique([activity_id, student_id], map: "uk_activity_student")
  @@index([student_id], map: "idx_student")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model archive_files {
  id             String    @id @db.Char(36)
