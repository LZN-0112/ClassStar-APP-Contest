# 服务器配置
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MySQL 数据库配置
# 请替换为实际账号；密码含特殊字符时必须 URL 编码（例如 # 写成 %23，@ 写成 %40）
DATABASE_URL=mysql://class_app:change_me@localhost:3306/class_manage_db
DATABASE_READONLY_URL=mysql://class_readonly:change_me@localhost:3306/class_manage_db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# MinIO/OSS 配置
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=class-assistant
MINIO_PUBLIC_URL=http://localhost:9000

# 日志配置
LOG_LEVEL=info

# AI 发布助手（OpenAI 兼容接口；未配置 AI_API_KEY 时自动使用本地规则解析）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus

# 监控台管理员白名单（英文逗号分隔手机号；生产环境未配置时禁止访问 /monitor）
MONITOR_ADMIN_PHONES=

# 微信开放平台移动应用（App 微信登录，未配置时微信登录不可用）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
