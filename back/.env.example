# 鏈嶅姟鍣ㄩ厤缃?
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MySQL 鏁版嵁搴撻厤缃?
DATABASE_URL=mysql://<db_user>:<db_password>@localhost:3306/class_assistant
DATABASE_READONLY_URL=mysql://<readonly_user>:<readonly_password>@localhost:3306/class_assistant

# Redis 閰嶇疆
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 閰嶇疆
JWT_SECRET=your_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# MinIO/OSS 閰嶇疆
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=class-assistant
MINIO_PUBLIC_URL=http://localhost:9000

# 鏃ュ織閰嶇疆
LOG_LEVEL=info
