# 校园班级事务智能管理助手 — 后端环境变量模板
# 复制本文件为 .env 后生效（不要直接修改本模板文件）
# 数据库名使用全新的 class_manage_db，不触碰原有 class_assistant

# 服务器配置
# 部署到服务器时改为 production（会关闭 Swagger、启用 CORS 白名单与反向代理信任）
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MySQL 数据库配置（本地开发示例；生产请使用独立账号与强随机密码）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=class_manage_db

# Prisma 使用的连接字符串（与上方参数一致）
# 注意：密码中的特殊字符必须 URL 编码（例如 # 需写成 %23）
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_READONLY_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis 配置（可选，无 Redis 时部分缓存/会话功能不可用）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置（生产环境请务必替换为强随机字符串，长度 ≥ 32）
JWT_SECRET=dev_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# MinIO/OSS 配置（可选，无 MinIO 时文件上传功能不可用）
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=class-assistant
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_LOCAL_FALLBACK=true
# 本地上传回退目录（生产建议指向持久化目录，避免发布时被清空；不填则用 back/tmp/minio-fallback）
# MINIO_LOCAL_DIR=/var/www/banwuxing/uploads-data

# 百度 OCR 配置（可选，用于作业离线核对截图识别）
# 从百度智能云控制台获取：https://console.bce.baidu.com/ai/#/ai/ocr/overview
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 日志配置
LOG_LEVEL=info

# AI 发布助手（OpenAI 兼容接口；未配置 AI_API_KEY 时自动使用本地规则解析）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus

# ===== 生产环境额外配置（部署到服务器时填写）=====
# CORS 白名单：英文逗号分隔的完整来源，例如 https://banwu.example.com
# 生产环境未列入白名单的浏览器来源将被拒绝（App / 小程序无 Origin 头，不受影响）
CORS_ORIGINS=
# 反向代理层数：Nginx 直接反代到本服务时填 1，用于获取真实客户端 IP
TRUST_PROXY=1
# 监控台管理员手机号白名单（英文逗号分隔；生产未配置时禁止访问 /monitor）
MONITOR_ADMIN_PHONES=

# 错误通知邮件（可选，不填则不发送）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ERROR_NOTIFY_EMAILS=

# ===== 微信开放平台移动应用（App 微信登录）=====
# 在 https://open.weixin.qq.com 移动应用详情中获取；AppSecret 仅放后端，禁止写入前端或公开仓库
WECHAT_APP_ID=
WECHAT_APP_SECRET=
