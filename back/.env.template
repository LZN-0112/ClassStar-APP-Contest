# 鏍″洯鐝骇浜嬪姟鏅鸿兘绠＄悊鍔╂墜 鈥?鍚庣鐜鍙橀噺妯℃澘
# 澶嶅埗鏈枃浠朵负 .env 鍚庣敓鏁堬紙涓嶈鐩存帴淇敼鏈ā鏉挎枃浠讹級
# 鏁版嵁搴撳悕浣跨敤鍏ㄦ柊鐨?class_manage_db锛屼笉瑙︾鍘熸湁 class_assistant

# 鏈嶅姟鍣ㄩ厤缃?
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MySQL 鏁版嵁搴撻厤缃紙鏈湴 root 璐﹀彿锛屽紑鍙戠幆澧冧娇鐢級
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<your_db_password>
DB_NAME=class_manage_db

# Prisma 浣跨敤鐨勮繛鎺ュ瓧绗︿覆锛堜笌涓婃柟鍙傛暟涓€鑷达級
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_READONLY_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis 閰嶇疆锛堝彲閫夛紝鏃?Redis 鏃堕儴鍒嗙紦瀛?浼氳瘽鍔熻兘涓嶅彲鐢級
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 閰嶇疆锛堢敓浜х幆澧冭鍔″繀鏇挎崲涓哄己闅忔満瀛楃涓诧紝闀垮害 鈮?32锛?
JWT_SECRET=dev_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# MinIO/OSS 閰嶇疆锛堝彲閫夛紝鏃?MinIO 鏃舵枃浠朵笂浼犲姛鑳戒笉鍙敤锛?
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=class-assistant
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_LOCAL_FALLBACK=true

# 鐧惧害 OCR 閰嶇疆锛堝彲閫夛紝鐢ㄤ簬浣滀笟绂荤嚎鏍稿鎴浘璇嗗埆锛?
