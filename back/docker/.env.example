# 班务星 内部测试部署环境变量
# 复制本文件为 .env 后填写（.env 不要提交到代码库、不要外发）
# 所有密码请使用强随机字符串，不要沿用示例值

# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=改成强随机root密码
DB_NAME=class_manage_db
DB_USER=banwuxing
DB_PASSWORD=改成强随机业务密码
# 宿主机端口映射（服务器上 3306 被占用时改这里，容器内部始终 3306）
MYSQL_PORT=3306

# ===== 后端 =====
# 宿主机端口映射（默认 3000，即 APK 访问的端口）
BACKEND_PORT=3000

# JWT 密钥：长度 ≥ 32 的随机字符串，两个必须不同
JWT_SECRET=改成至少32位随机字符串
JWT_REFRESH_SECRET=改成另一个至少32位随机字符串
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# CORS 白名单：App（Capacitor WebView）来源是 http://localhost，必须保留
# 如后续增加浏览器后台域名，用英文逗号追加，例如 http://localhost,https://banwu.example.com
CORS_ORIGINS=http://localhost

# 无反向代理直连时设 0；前面有一层 Nginx 反代时设 1
TRUST_PROXY=0

LOG_LEVEL=info

# 监控台管理员手机号白名单（英文逗号分隔，可留空）
MONITOR_ADMIN_PHONES=