<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Capacitor 深链接：adb 可用 am start -d "http://localhost/<路由>" 直达页面，便于真机逐页验证 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="localhost" />
                <data android:scheme="https" android:host="localhost" />
            </intent-filter>

            <!-- 班级邀请二维码：系统相机/浏览器扫码后可直接唤起 App 并进入加入班级页 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="class-assistant" android:host="class" android:pathPrefix="/join" />
            </intent-filter>

        </activity>

        <!-- 微信开放平台回调入口：必须是 包名.wxapi.WXEntryActivity -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.banwuxing.app"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 极光推送：通知点击回调（与插件自带接收器并存，只做加法）。
             仅用于把通知 extras 交给 Web 层做页面跳转，不处理其它推送事件 -->
        <receiver
            android:name=".PushMessageReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter android:priority="1000">
                <action android:name="cn.jpush.android.intent.RECEIVER_MESSAGE" />
                <category android:name="${applicationId}" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 极光推送 AppKey：
             jpush-phonegap-plugin 的 Cordova 清单里会写入 JPUSH_APPKEY="undefined"，
             这里用更高优先级覆盖。AppKey 与包名 com.banwuxing.app 绑定 -->
        <meta-data
            android:name="JPUSH_APPKEY"
            android:value="aad09f6968978747d9cc571c"
            tools:replace="android:value" />
        <meta-data
            android:name="JPUSH_CHANNEL"
            android:value="developer-default"
            tools:replace="android:value" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 摄像头（扫码/人脸签到/作业拍照/文件选择拍照） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 定位（GPS 签到/发布考勤） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 麦克风（AI 助手语音发布） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WebView 录音必需：Capacitor 的 onPermissionRequest 会把 MODIFY_AUDIO_SETTINGS 与
         RECORD_AUDIO 一起申请，缺少声明会导致整个 WebView 麦克风授权被拒（NotAllowedError） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+ 查询系统语音识别服务与微信客户端（微信登录唤起/安装检测） -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.tencent.mm" />
    </queries>

    <!-- 相机与定位均为可选能力：声明 required=false，避免无摄像头/无定位的设备（如平板）被应用商店判定不兼容 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- 极光推送：SDK 自身需要的非敏感权限；SDK 在用户同意隐私政策后才初始化 -->
    <!-- Android 13+ 通知权限，需在运行时动态申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 裁剪 jpush-phonegap-plugin 清单里申请的高敏感/应用商店敏感权限：
         推送功能不需要通话状态、存储、后台定位与全量应用列表查询 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
</manifest>
